{
  "format": "hgde-embedding-visualization-v1",
  "dataset": "pokemon",
  "embedding_column": "text_vector",
  "label_column": "color",
  "n_items": 1000,
  "embedding_dim": 1024,
  "run_settings": {
    "model": "triplet",
    "eval": "triplet",
    "lr": 0.0001,
    "epochs": 10,
    "rounds": 10,
    "hidden_size": 4096,
    "dropout": 0.1,
    "scaling_factor": 0.1,
    "batch_size": 16,
    "l1_reg": 0.0001,
    "preservation_weight": 0.05,
    "save_file": "results/triplet_run.json",
    "visualization_dir": "results/visualization_data/triplet",
    "simple": false,
    "benchmark1_only": false,
    "clusterer": null,
    "k": null,
    "verbose": false
  },
  "files": {
    "baseline": "baseline_embeddings.npy",
    "transformed": "transformed_embeddings.npy",
    "assignments": "assignments.csv"
  }
}